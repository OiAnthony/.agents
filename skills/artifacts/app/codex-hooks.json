{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/skills/artifacts/app/codex-hook\" codex-bind",
            "commandWindows": "exit 0",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/skills/artifacts/app/codex-hook\" codex-watch",
            "commandWindows": "exit 0",
            "async": true,
            "timeout": 86400
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/skills/artifacts/app/codex-hook\" codex-bind",
            "commandWindows": "exit 0",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/skills/artifacts/app/codex-hook\" codex-watch",
            "commandWindows": "exit 0",
            "async": true,
            "timeout": 86400
          },
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/skills/artifacts/app/codex-hook\" event codex",
            "commandWindows": "exit 0",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/skills/artifacts/app/codex-hook\" codex-stop",
            "commandWindows": "exit 0",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/skills/artifacts/app/codex-hook\" event codex",
            "commandWindows": "exit 0",
            "timeout": 3,
            "async": false
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/skills/artifacts/app/codex-hook\" event codex",
            "commandWindows": "exit 0",
            "timeout": 5,
            "async": false
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/skills/artifacts/app/codex-hook\" event codex",
            "commandWindows": "exit 0",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/skills/artifacts/app/codex-hook\" event codex",
            "commandWindows": "exit 0",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/skills/artifacts/app/codex-hook\" event codex",
            "commandWindows": "exit 0",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/skills/artifacts/app/codex-hook\" event codex",
            "commandWindows": "exit 0",
            "timeout": 3,
            "async": false
          }
        ]
      }
    ]
  }
}
